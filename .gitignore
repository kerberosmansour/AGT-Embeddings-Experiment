# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS / editor noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python scratch environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local model/runtime caches
.cache/
models/
*.onnx

# Experiment scratch outputs; committed evidence should live under artifacts/
scratch/
tmp/
*.tmp

# Round-4 smoke reproduction outputs
corpus/round4/*-smoke.json
corpus/round4/*-smoke.jsonl
corpus/round4/*-smoke-summary.json
corpus/round4/*-smoke-metrics.json

# Round-6 cascade experiment
.venv-round6/
.cache/round6-embeddings/
artifacts/round6-cascade/**/*.tmp
