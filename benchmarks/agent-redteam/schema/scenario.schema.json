{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_class": {
      "minLength": 3,
      "type": "string"
    },
    "controls": {
      "items": {
        "pattern": "^AGT-AC-[0-9]{3}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "delivery_surface": {
      "minLength": 3,
      "type": "string"
    },
    "delivery_vector": {
      "enum": [
        "direct_prompt",
        "carrier_document",
        "browser_dom",
        "tool_result",
        "memory_record",
        "a2a_message",
        "approval_request",
        "reporting_artifact"
      ]
    },
    "detection": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "pattern": "^(sha256:)?[0-9a-f]{64}$",
          "type": "string"
        },
        "detector_id": {
          "minLength": 3,
          "type": "string"
        },
        "evidence_level": {
          "const": "L1_static"
        },
        "verdict": {
          "enum": [
            "flagged",
            "clean",
            "not_run"
          ]
        }
      },
      "required": [
        "verdict"
      ],
      "type": "object"
    },
    "environment_fixtures": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_expected": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "expected_containment": {
      "enum": [
        "allow",
        "require_approval",
        "quarantine",
        "block",
        "contain",
        "not_applicable"
      ]
    },
    "id": {
      "pattern": "^[a-z0-9-]+-[0-9]{3}$",
      "type": "string"
    },
    "action_outcome": {
      "enum": [
        "attempted",
        "executed",
        "blocked",
        "contained"
      ]
    },
    "payload_ref": {
      "additionalProperties": false,
      "properties": {
        "corpus_manifest_hash": {
          "pattern": "^(sha256:)?[0-9a-f]{64}$",
          "type": "string"
        },
        "family": {
          "minLength": 3,
          "type": "string"
        },
        "id": {
          "minLength": 3,
          "type": "string"
        },
        "split": {
          "enum": [
            "exemplar",
            "exemplar_bank",
            "validation",
            "test"
          ]
        }
      },
      "required": [
        "id",
        "family",
        "split",
        "corpus_manifest_hash"
      ],
      "type": "object"
    },
    "session_model": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "minimum": 1,
          "type": "integer"
        },
        "stateful": {
          "type": "boolean"
        },
        "turns": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "turns",
        "stateful",
        "agents"
      ],
      "type": "object"
    },
    "standards": {
      "additionalProperties": false,
      "properties": {
        "aivss_metrics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "asi": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "opencre_relations": {
          "items": {
            "enum": [
              "exact",
              "broad",
              "narrow",
              "related",
              "candidate"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "asi",
        "aivss_metrics",
        "opencre_relations"
      ],
      "type": "object"
    },
    "success_conditions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_layer": {
      "enum": [
        "input",
        "retrieval",
        "memory",
        "tool",
        "browser",
        "a2a",
        "human_approval",
        "reporting"
      ]
    },
    "title": {
      "minLength": 8,
      "type": "string"
    },
    "trap_class": {
      "enum": [
        "Content Injection",
        "Semantic Manipulation",
        "Cognitive State",
        "Behavioural Control",
        "Systemic",
        "Human-in-the-Loop"
      ]
    },
    "views": {
      "additionalProperties": false,
      "properties": {
        "agent_visible": {
          "type": "string"
        },
        "human_visible": {
          "type": "string"
        }
      },
      "required": [
        "human_visible",
        "agent_visible"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "trap_class",
    "attack_class",
    "target_layer",
    "delivery_surface",
    "views",
    "session_model",
    "environment_fixtures",
    "controls",
    "standards",
    "success_conditions",
    "evidence_expected"
  ],
  "title": "AGT Red Team Scenario v2 scratch schema",
  "type": "object"
}
