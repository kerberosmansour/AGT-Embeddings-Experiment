{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_class": {
      "minLength": 3,
      "type": "string"
    },
    "controls": {
      "items": {
        "pattern": "^AGT-AC-[0-9]{3}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "delivery_surface": {
      "minLength": 3,
      "type": "string"
    },
    "environment_fixtures": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_expected": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evasion_technique": {
      "enum": [
        "none",
        "hidden_content",
        "format_smuggling",
        "render_parse_divergence",
        "encoding_indirection",
        "authority_spoofing",
        "roleplay_legitimacy",
        "goal_reframing",
        "ambiguous_scope",
        "state_carryover",
        "memory_shadowing",
        "preference_poisoning",
        "cross_session_echo",
        "approval_fatigue",
        "tool_schema_confusion",
        "irreversible_pressure",
        "least_privilege_blur",
        "cross_agent_relay",
        "mcp_registry_misdirection",
        "package_name_confusion",
        "delegation_loop",
        "fake_approval",
        "social_proof_pressure",
        "time_pressure",
        "visible_safe_hidden_unsafe"
      ],
      "type": "string"
    },
    "expected_control_behavior": {
      "enum": [
        "detect_or_block",
        "allow_or_clarify"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9-]+-[0-9]{3}$",
      "type": "string"
    },
    "measurement_suite": {
      "enum": [
        "agt_redteam_measurement_v2"
      ],
      "type": "string"
    },
    "live_probe": {
      "additionalProperties": false,
      "properties": {
        "agent_visible": {
          "minLength": 20,
          "type": "string"
        },
        "expected_tool": {
          "enum": [
            "shell",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "agent_visible",
        "expected_tool"
      ],
      "type": "object"
    },
    "scenario_kind": {
      "enum": [
        "canonical_positive",
        "evasion_positive",
        "hard_benign",
        "near_miss"
      ],
      "type": "string"
    },
    "session_model": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "minimum": 1,
          "type": "integer"
        },
        "stateful": {
          "type": "boolean"
        },
        "turns": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "turns",
        "stateful",
        "agents"
      ],
      "type": "object"
    },
    "standards": {
      "additionalProperties": false,
      "properties": {
        "aivss_metrics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "asi": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "opencre_relations": {
          "items": {
            "enum": [
              "exact",
              "broad",
              "narrow",
              "related",
              "candidate"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "asi",
        "aivss_metrics",
        "opencre_relations"
      ],
      "type": "object"
    },
    "success_conditions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_layer": {
      "enum": [
        "input",
        "retrieval",
        "memory",
        "tool",
        "browser",
        "a2a",
        "human_approval",
        "reporting"
      ]
    },
    "title": {
      "minLength": 8,
      "type": "string"
    },
    "trap_class": {
      "enum": [
        "Content Injection",
        "Semantic Manipulation",
        "Cognitive State",
        "Behavioural Control",
        "Systemic",
        "Human-in-the-Loop"
      ]
    },
    "views": {
      "additionalProperties": false,
      "properties": {
        "agent_visible": {
          "type": "string"
        },
        "human_visible": {
          "type": "string"
        }
      },
      "required": [
        "human_visible",
        "agent_visible"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "trap_class",
    "attack_class",
    "target_layer",
    "delivery_surface",
    "views",
    "session_model",
    "environment_fixtures",
    "controls",
    "standards",
    "success_conditions",
    "evidence_expected"
  ],
  "title": "AGT Red Team Scenario v2 scratch schema",
  "type": "object"
}
